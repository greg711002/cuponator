// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Stores ─────────────────────────────────────────────────────────

model Store {
  id          BigInt   @id @default(autoincrement()) @db.BigInt
  name        String   @db.VarChar(255)
  slug        String   @unique @db.VarChar(255)
  logoUrl     String?  @map("logo_url") @db.Text
  description String?  @db.Text
  websiteUrl  String   @map("website_url") @db.Text
  categoryId  BigInt   @map("category_id") @db.BigInt
  cpaNetwork  String?  @map("cpa_network") @db.VarChar(255)
  cpaParams   Json?    @map("cpa_params") @db.JsonB
  sortOrder   Int      @default(500) @map("sort_order")
  isFeatured  Boolean  @default(false) @map("is_featured")
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  category Category @relation(fields: [categoryId], references: [id])
  coupons  Coupon[]
  sources  Source[]

  @@map("stores")
}

// ─── Categories ─────────────────────────────────────────────────────

model Category {
  id        BigInt  @id @default(autoincrement()) @db.BigInt
  name      String  @db.VarChar(255)
  slug      String  @unique @db.VarChar(255)
  icon      String? @db.VarChar(50)
  sortOrder Int     @default(500) @map("sort_order")
  isActive  Boolean @default(true) @map("is_active")

  stores Store[]

  @@map("categories")
}

// ─── Coupons ────────────────────────────────────────────────────────

enum CouponStatus {
  imported
  pending_check
  duplicate
  active
  paused
  expired
  rejected
  archived

  @@map("coupon_status")
}

enum DiscountType {
  percentage
  fixed_amount
  free_delivery
  bonus
  gift
  other

  @@map("discount_type")
}

model Coupon {
  id             BigInt        @id @default(autoincrement()) @db.BigInt
  storeId        BigInt        @map("store_id") @db.BigInt
  title          String        @db.VarChar(500)
  description    String?       @db.Text
  code           String?       @db.VarChar(255)
  promoUrl       String?       @map("promo_url") @db.Text
  discountType   DiscountType  @default(percentage) @map("discount_type")
  discountValue  String        @map("discount_value") @db.VarChar(100)
  conditions     String?       @db.Text
  minOrderAmount Decimal?      @map("min_order_amount") @db.Decimal(10, 2)
  startsAt       DateTime      @map("starts_at")
  expiresAt      DateTime?     @map("expires_at")
  isVerified     Boolean       @default(false) @map("is_verified")
  verifiedAt     DateTime?     @map("verified_at")
  clickCount     BigInt        @default(0) @map("click_count") @db.BigInt
  sortOrder      Int           @default(500) @map("sort_order")
  status         CouponStatus  @default(imported)
  priority       Int           @default(5)
  dataSource     String?       @map("data_source") @db.VarChar(255)
  sourceUrl      String?       @map("source_url") @db.Text
  meta           Json?         @default("{}") @db.JsonB
  createdAt      DateTime      @default(now()) @map("created_at")
  updatedAt      DateTime      @updatedAt @map("updated_at")

  store Store @relation(fields: [storeId], references: [id])
  clicks Click[]

  @@index([storeId])
  @@index([status])
  @@index([expiresAt])
  @@index([discountType])
  @@map("coupons")
}

// ─── Clicks (CPA tracking) ─────────────────────────────────────────

model Click {
  id          BigInt    @id @default(autoincrement()) @db.BigInt
  couponId    BigInt    @map("coupon_id") @db.BigInt
  clickId     String    @unique @map("click_id") @db.VarChar(255)
  subid       String?   @db.VarChar(255)
  ipAddress   String?   @map("ip_address") @db.VarChar(45)
  userAgent   String?   @map("user_agent") @db.Text
  referrer    String?   @db.Text
  converted   Boolean   @default(false)
  convertedAt DateTime? @map("converted_at")
  revenue     Decimal?  @map("revenue") @db.Decimal(10, 4)
  createdAt   DateTime  @default(now()) @map("created_at")

  coupon Coupon @relation(fields: [couponId], references: [id])

  @@index([couponId])
  @@index([clickId])
  @@index([converted])
  @@map("clicks")
}

// ─── Sources (data import sources) ──────────────────────────────────

model Source {
  id         BigInt    @id @default(autoincrement()) @db.BigInt
  name       String    @db.VarChar(255)
  type       String    @db.VarChar(50)
  storeId    BigInt?   @map("store_id") @db.BigInt
  config     Json?     @default("{}") @db.JsonB
  isActive   Boolean   @default(true) @map("is_active")
  lastSyncAt DateTime? @map("last_sync_at")
  createdAt  DateTime  @default(now()) @map("created_at")

  store Store? @relation(fields: [storeId], references: [id])

  @@map("sources")
}

// ─── Audit Log ──────────────────────────────────────────────────────

model AuditLog {
  id         BigInt       @id @default(autoincrement()) @db.BigInt
  entityType String       @map("entity_type") @db.VarChar(50)
  entityId   BigInt       @map("entity_id") @db.BigInt
  action     String       @db.VarChar(50)
  oldStatus  CouponStatus? @map("old_status")
  newStatus  CouponStatus? @map("new_status")
  changes    Json?        @default("{}") @db.JsonB
  changedBy  String?      @map("changed_by") @db.VarChar(255)
  reason     String?      @db.Text
  createdAt  DateTime     @default(now()) @map("created_at")

  @@index([entityType, entityId])
  @@index([createdAt])
  @@map("audit_log")
}